        "action": "FOCUS",
        "conceptId": "matching"
      }
    },
    {
      "id": "h32",
      "split": "heldOut",
      "kind": "paraphrase",
      "text": "When it's unsure, it plays it safe and keeps the current picture.",
      "expect": {
        "action": "FOCUS",
        "conceptId": "matching"
      }
    },
    {
      "id": "h33",
      "split": "heldOut",
      "kind": "paraphrase",
      "text": "Side by side, the traditional deck loses on almost every point.",
