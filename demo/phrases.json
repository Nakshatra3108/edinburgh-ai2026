    {
      "id": "r24",
      "split": "rehearsal",
      "kind": "paraphrase",
      "text": "All the heavy preparation is done once, ahead of time, and then I check it.",
      "expect": {
        "action": "FOCUS",
        "conceptId": "architecture"
      }
    },
    {
      "id": "h25",
      "split": "heldOut",
      "kind": "paraphrase",
      "text": "Ever been stuck behind a slide you weren't ready to talk about yet?",
      "expect": {
        "action": "FOCUS",
        "conceptId": "problem"
      }
    },
    {
      "id": "h26",
      "split": "heldOut",
      "kind": "paraphrase",
      "text": "The deck dictates the path and the speaker just tags along.",
      "expect": {
        "action": "FOCUS",
        "conceptId": "problem"
      }
    },
    {
      "id": "h27",
      "split": "heldOut",
      "kind": "paraphrase",
